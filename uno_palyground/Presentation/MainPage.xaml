<Page x:Class="uno_palyground.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:uno_palyground.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      NavigationCacheMode="Required"
      xmlns:ScottPlot="using:ScottPlot.WinUI"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer IsTabStop="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="3*"/>
      </Grid.RowDefinitions>
      <utu:NavigationBar Content="{Binding Title}"/>
      <ScottPlot:WinUIPlot  Grid.Row="1"
          x:Name="WinUIPlotModulation"/>
      <ScottPlot:WinUIPlot Grid.Row="2"
          x:Name="WinUIPlotVideo"/>
    </Grid>
  </ScrollViewer>
</Page>
