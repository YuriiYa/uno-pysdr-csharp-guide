        <mxCell id="yevV4R-_mww2Urk_IH_g-8" value="Color&amp;nbsp;= Q sin (ωt + 33°) + I cos (ωt + 33°)&lt;div&gt;ω = 2πFSC&lt;/div&gt;&lt;div&gt;FSC = 3.579545 MHz (± 10 Hz)&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=50;align=center;verticalAlign=middle;strokeWidth=1;autosize=1;spacing=4;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" parent="UxEVvuUElZgrL1N4Tevr-11" vertex="1">
