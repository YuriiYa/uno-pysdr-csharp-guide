        <mxCell id="UxEVvuUElZgrL1N4Tevr-58" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;“color difference”&lt;/h1&gt;&lt;p&gt;R´ – Y = 0.701R´ – 0.587G´ – 0.114B´&lt;/p&gt;&lt;p&gt;B´ – Y = –0.299R´ – 0.587G´ + 0.886B´&lt;/p&gt;&lt;p&gt;U = 0.492(B´ – Y)&lt;/p&gt;&lt;p&gt;V = 0.877(R´ – Y)&lt;/p&gt;&lt;p&gt;I = 0.596R´ – 0.275G´ – 0.321B´&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;= Vcos 33° – Usin 33°&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;= 0.736(R´ – Y) – 0.268(B´ – Y)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Q = 0.212R´ – 0.523G´ + 0.311B´&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;= Vsin 33° + Ucos 33°&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;= 0.478(R´ – Y) + 0.413(B´ – Y)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Small objects occupy&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;1.3–2.0 MHz&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Medium&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;0.6–1.3&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Larger&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;0–0.6 MHz&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="UxEVvuUElZgrL1N4Tevr-11" vertex="1">
