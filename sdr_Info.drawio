        <mxCell id="yevV4R-_mww2Urk_IH_g-13" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="UxEVvuUElZgrL1N4Tevr-11" vertex="1">
